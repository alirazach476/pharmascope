# PharmaScope environment configuration
# Copy to .env and adjust values. Never commit real secrets.

# Application
PHARMASCOPE_ENV=development
PHARMASCOPE_LOG_LEVEL=INFO
PHARMASCOPE_DATA_ROOT=./data
PHARMASCOPE_CONFIG_DIR=./configs

# OpenFDA (optional API key increases rate limits)
# Register at: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
OPENFDA_BASE_URL=https://api.fda.gov
OPENFDA_TIMEOUT_SECONDS=60
OPENFDA_MAX_RETRIES=5
OPENFDA_DEFAULT_LIMIT=100
OPENFDA_MAX_CONCURRENCY=2

# Development extraction bounds (prevent accidental large downloads)
PHARMASCOPE_DEV_RECORD_LIMIT=1000
PHARMASCOPE_ALLOW_FULL_DOWNLOAD=false

# DuckDB analytical warehouse
DUCKDB_PATH=./data/metadata/pharmascope.duckdb

# PostgreSQL (optional — application metadata)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pharmascope
POSTGRES_USER=pharmascope
POSTGRES_PASSWORD=change_me

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:5173,http://127.0.0.1:5173

# Dashboard
STREAMLIT_SERVER_PORT=8501
